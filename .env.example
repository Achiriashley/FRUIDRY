# Copy this file to .env.local and fill in the values.

# Password for the orders admin page at /admin (required to confirm payments).
ADMIN_PASSWORD=

# Optional: your site's public address, used in receipt links sent on WhatsApp.
SITE_URL=

# Optional: store orders and product edits in Supabase (needed on hosts like Vercel).
# Leave empty to save orders in data/orders.json on the server instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
